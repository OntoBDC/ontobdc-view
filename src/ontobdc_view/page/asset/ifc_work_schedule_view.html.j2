<script id="ontobdc-gantt-loader">
(function () {
  if (!window.__ontobdcGanttLoader) {
    window.__ontobdcGanttLoader = {};
  }
  var SCRIPT_NAMES = {{ gantt_script_names | list | tojson }};
  var PYODIDE_JS_PATH = "ifc_work_schedule_view/pyodide/v0.27.2/full/pyodide.js";
  var ASSET_SCRIPT_PREFIX = "ifc_work_schedule_view/";

  function findAssetBase() {
    var here = location.href;
    var cut = here.indexOf("#");
    if (cut !== -1) here = here.substring(0, cut);
    cut = here.indexOf("?");
    if (cut !== -1) here = here.substring(0, cut);
    var parts = here.split("/");
    while (parts.length > 0) {
      parts.pop();
      var candidate = parts.join("/");
      if (!candidate) continue;
      try {
        var testTail = candidate.split("/").pop();
        if (testTail === ".__ontobdc__") {
          return candidate + "/asset/";
        }
      } catch (e) {}
    }
    var up = parts.slice(0, -1).join("/") || location.origin;
    return (up || location.origin) + "/asset/";
  }

  var base = findAssetBase();
  window.__ONTOBDC_ASSET_BASE_URL__ = base;
  window.__ontobdcGanttLoader.assetBase = base;
  var failed = [];
  var loaded = 0;
  var __ontobdcCacheBust = "v=20260823";
  var expected = SCRIPT_NAMES.length;

  var earlyFailures = Array.isArray(window.__ontobdcEarlyProtocolFailures) ? window.__ontobdcEarlyProtocolFailures.slice() : [];
  if (earlyFailures.length > 0) {
    try {
      window.setTimeout(function () {
        var first = earlyFailures[0] || {};
        var msg = first.message || first.context || "Unknown protocol failure";
        if (typeof showRuntimeProtocolBanner === "function") {
          showRuntimeProtocolBanner(msg);
        } else {
          showError();
        }
      }, 0);
    } catch (e) { /* noop */ }
  }
  var banner = null;

  function ensureBanner() {
    if (banner) return banner;
    banner = document.createElement("div");
    banner.setAttribute("role", "alert");
    banner.setAttribute("aria-live", "assertive");
    var bg = document.documentElement.dataset.theme === "dark" ? "#450a0a" : "#fef2f2";
    var fg = document.documentElement.dataset.theme === "dark" ? "#fecaca" : "#7f1d1d";
    var bd = document.documentElement.dataset.theme === "dark" ? "#f87171" : "#dc2626";
    banner.style.cssText =
      "position:fixed;z-index:2147483647;top:12px;left:12px;right:12px;padding:16px 18px;border:1px solid " +
      bd +
      ";border-radius:12px;background:" +
      bg +
      ";color:" +
      fg +
      ";font:700 13px ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;letter-spacing:.01em;box-shadow:0 18px 40px rgba(0,0,0,.5);text-align:left;";
    banner.id = "ontobdc-gantt-loader-errors";
    document.documentElement.appendChild(banner);
    return banner;
  }

  function showError() {
    if (failed.length === 0) return;
    var box = ensureBanner();
    var title = document.createElement("div");
    title.textContent = "Failed to load Gantt runtime scripts (" + failed.length + "/" + expected + ").";
    title.style.cssText = "margin:0 0 8px 0;font-size:14px;font-weight:900;text-transform:uppercase;letter-spacing:.04em;";
    var help = document.createElement("div");
    help.textContent = "Asset folder auto-detected at: " + base;
    help.style.cssText = "margin:0 0 10px 0;font-weight:600;opacity:.85;";
    var ul = document.createElement("ul");
    ul.style.cssText = "margin:0;padding-left:1.25rem;display:grid;gap:4px;";
    failed.forEach(function (item) {
      var li = document.createElement("li");
      li.textContent = item.name + " -> " + item.url;
      li.style.cssText = "word-break:break-all;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;font-weight:600;opacity:.95;";
      ul.appendChild(li);
    });
    var tip = document.createElement("div");
    tip.textContent =
      "Open this page via HTTP (python -m http.server 8765) instead of double-clicking the HTML file. Protocol file:// blocks some runtime modules even when paths are correct.";
    tip.style.cssText = "margin-top:12px;padding-top:12px;border-top:1px dashed rgba(220,38,38,.55);font-size:11.5px;font-weight:600;opacity:.9;";
    box.innerHTML = "";
    box.appendChild(title);
    box.appendChild(help);
    box.appendChild(ul);
    box.appendChild(tip);
  }

  function loadOne(kind, name, suffix, index) {
    var s = document.createElement("script");
    // Dynamically-inserted scripts are async by default and would run in
    // network-race order; async=false forces execution in insertion order
    // (SCRIPT_NAMES order), which the runtime depends on — i18n_apply must
    // attach runtime.t before container_connection/pyodide_runtime capture
    // it, pyodide_runtime before task_table_timeline, and so on.
    s.async = false;
    s.defer = true;
    var rel = kind === "pyodide" ? PYODIDE_JS_PATH : ASSET_SCRIPT_PREFIX + name + suffix;
    var url = base + rel;
    if (kind !== "pyodide") {
      url += (url.indexOf("?") === -1 ? "?" : "&") + __ontobdcCacheBust;
    }
    s.src = url;
    s.setAttribute("data-ontobdc-script-kind", kind);
    s.setAttribute("data-ontobdc-order", String(index));
    function onFail() {
      failed.push({ kind: kind, name: name, url: url });
      loaded += 1;
      showError();
    }
    function onOk() {
      loaded += 1;
      if (loaded >= expected) window.dispatchEvent(new CustomEvent("ontobdc:gantt-scripts-ready", { detail: { assetBase: base } }));
    }
    s.addEventListener("error", onFail);
    s.addEventListener("load", onOk);
    (document.head || document.documentElement).appendChild(s);
  }

  loadOne("builder", SCRIPT_NAMES[0], ".js", 0);
  SCRIPT_NAMES.slice(1).forEach(function (name, i) {
    loadOne("builder", name, ".js", i + 1);
  });

  function looksLikeFileProtocolFailure(msg) {
    if (!msg) return false;
    var s = String(msg).toLowerCase();
    return (
      s.indexOf("cors policy") !== -1 ||
      s.indexOf("origin 'null'") !== -1 ||
      s.indexOf("origin null") !== -1 ||
      (s.indexOf("failed to fetch") !== -1) ||
      (s.indexOf("failed to fetch dynamically imported module") !== -1) ||
      (s.indexOf("net::err_failed") !== -1) ||
      (s.indexOf("net::err_file_not_found") !== -1) ||
      (s.indexOf("access to fetch at 'file:") !== -1) ||
      (s.indexOf("access to script at 'file:") !== -1) ||
      (s.indexOf("protocol file://") !== -1)
    );
  }
  var runtimeBannerShown = false;
  function showRuntimeProtocolBanner(firstMsg) {
    if (runtimeBannerShown) return;
    runtimeBannerShown = true;
    var box = ensureBanner();
    var title = document.createElement("div");
    title.textContent = "Gantt runtime blocked by browser protocol restrictions.";
    title.style.cssText = "margin:0 0 8px 0;font-size:14px;font-weight:900;text-transform:uppercase;letter-spacing:.04em;";
    var help = document.createElement("div");
    help.textContent = "Asset folder auto-detected at: " + base;
    help.style.cssText = "margin:0 0 10px 0;font-weight:600;opacity:.85;";
    var why = document.createElement("div");
    why.textContent = "First error detected: " + (firstMsg || "(unknown)");
    why.style.cssText = "margin:0 0 10px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;font-weight:600;word-break:break-all;";
    var tip = document.createElement("div");
    tip.textContent = "Open this page via HTTP (cd repo_root; python -m http.server 8765 --bind 127.0.0.1) then open http://127.0.0.1:8765/... in the browser. Protocol file:// is an opaque origin that blocks fetch(), dynamic import() and cross-file XHR — this is a browser security rule, not a bug in the page. Pyodide WASM modules and workbook datapackage reads require HTTP to work.";
    tip.style.cssText = "margin-top:12px;padding-top:12px;border-top:1px dashed rgba(220,38,38,.55);font-size:11.5px;font-weight:600;opacity:.9;line-height:1.45;";
    box.innerHTML = "";
    box.appendChild(title);
    box.appendChild(help);
    box.appendChild(why);
    box.appendChild(tip);
  }
  window.addEventListener("unhandledrejection", function (ev) {
    var msg = "";
    try { if (ev.reason && ev.reason.message) msg = ev.reason.message; else if (typeof ev.reason === "string") msg = ev.reason; } catch (e) {}
    if (!msg) try { msg = String(ev.reason || ""); } catch (e) {}
    if (looksLikeFileProtocolFailure(msg)) showRuntimeProtocolBanner(msg);
  }, true);
  window.addEventListener("error", function (ev) {
    var msg = "";
    try { if (ev.message) msg = ev.message; else if (typeof ev.error === "string") msg = ev.error; else if (ev.error && ev.error.message) msg = ev.error.message; } catch (e) {}
    if (looksLikeFileProtocolFailure(msg)) showRuntimeProtocolBanner(msg);
  }, true);

  setTimeout(function () {
    if (loaded < expected && failed.length > 0) showError();
  }, 12000);
})();
</script>
