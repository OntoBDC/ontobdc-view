.gantt-filter-dialog {
  border: 1px solid color-mix(in srgb, var(--onto-theme-foreground, #111827) 18%, transparent);
  border-radius: 14px;
  padding: 0;
  min-width: min(420px, calc(100vw - 32px));
  background: var(--onto-theme-background, #fff);
  color: var(--onto-theme-foreground, #111827);
  box-shadow: 0 24px 70px rgba(0, 0, 0, .28);
  color-scheme: inherit;
}
.gantt-filter-dialog::backdrop { background: rgba(0,0,0,.38); }
.gantt-filter-form { display: grid; gap: 18px; padding: 20px; }
.gantt-filter-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; }
.gantt-filter-heading h2 { margin:0; font-size:18px; }
.gantt-filter-close { font-size:22px; line-height:1; }
.gantt-filter-field { display:grid; gap:7px; font-size:13px; font-weight:600; }
.gantt-filter-field input[type="date"] {
  width:100%; box-sizing:border-box; padding:9px 10px; border-radius:8px;
  border:1px solid color-mix(in srgb, var(--onto-theme-foreground, #111827) 22%, transparent);
  background:var(--onto-theme-background, #fff); color:var(--onto-theme-foreground, #111827);
  color-scheme: inherit;
}
.gantt-filter-toggle-row { display:flex; align-items:center; justify-content:space-between; gap:16px; font-size:13px; font-weight:600; cursor:pointer; }
.gantt-filter-toggle { position:relative; display:inline-flex; }
.gantt-filter-toggle input { position:absolute; opacity:0; pointer-events:none; }
.gantt-filter-toggle-track { width:42px; height:24px; border-radius:999px; background:color-mix(in srgb, var(--onto-theme-foreground, #111827) 24%, transparent); padding:2px; box-sizing:border-box; transition:.18s ease; }
.gantt-filter-toggle-thumb { display:block; width:20px; height:20px; border-radius:50%; background:var(--onto-theme-background, #fff); box-shadow:0 1px 4px rgba(0,0,0,.28); transition:.18s ease; }
.gantt-filter-toggle input:checked + .gantt-filter-toggle-track { background:var(--onto-theme-accent, #2563eb); }
.gantt-filter-toggle input:checked + .gantt-filter-toggle-track .gantt-filter-toggle-thumb { transform:translateX(18px); }
.gantt-filter-toggle-row.is-disabled { cursor:not-allowed; opacity:.5; }
.gantt-filter-toggle input:disabled + .gantt-filter-toggle-track { cursor:not-allowed; }
.gantt-filter-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:2px; }
.gantt-filter-actions button { padding:8px 14px; border-radius:8px; cursor:pointer; }
.gantt-filter-reset { background:transparent; color:inherit; border:1px solid color-mix(in srgb, var(--onto-theme-foreground, #111827) 22%, transparent); }
.gantt-filter-apply { border:0; background:var(--onto-theme-accent, #2563eb); color:#fff; }
.gantt-filter-btn[data-filter-active="true"] { outline:2px solid var(--onto-theme-accent, #2563eb); outline-offset:2px; }
