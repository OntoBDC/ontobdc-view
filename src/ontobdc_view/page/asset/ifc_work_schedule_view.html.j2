{% if has_gantt_payload %}<script id="ontobdc-early-error-capture">
(function () {
  var queue = window.__ontobdcEarlyProtocolFailures = window.__ontobdcEarlyProtocolFailures || [];
  function looksLikeFailure(s) {
    if (!s) return false;
    var t = String(s).toLowerCase();
    return (
      t.indexOf("cors policy") !== -1 ||
      t.indexOf("origin 'null'") !== -1 ||
      t.indexOf("origin null") !== -1 ||
      t.indexOf("failed to fetch") !== -1 ||
      t.indexOf("failed to fetch dynamically imported module") !== -1 ||
      t.indexOf("net::err_failed") !== -1 ||
      t.indexOf("net::err_file_not_found") !== -1 ||
      t.indexOf("access to fetch at 'file:") !== -1 ||
      t.indexOf("access to script at 'file:") !== -1 ||
      t.indexOf("protocol file://") !== -1 ||
      t.indexOf("cross origin requests are only supported") !== -1 ||
      t.indexOf("from origin 'null'") !== -1
    );
  }
  function collect(msg, ctx) {
    try { queue.push({ at: new Date().toISOString(), message: String(msg || ""), context: String(ctx || "") }); } catch (e) {}
  }
  window.addEventListener("error", function (ev) {
    var m = "";
    try { m = ev && ev.message ? ev.message : ""; } catch (e) {}
    if (!m) try { if (ev && ev.error) m = ev.error.message ? ev.error.message : String(ev.error); } catch (e) {}
    if (looksLikeFailure(m)) collect(m, "error");
  }, true);
  window.addEventListener("unhandledrejection", function (ev) {
    var m = "";
    try {
      if (typeof ev.reason === "string") m = ev.reason;
      else if (ev.reason && ev.reason.message) m = ev.reason.message;
      else m = String(ev.reason || "");
    } catch (e) {}
    if (looksLikeFailure(m)) collect(m, "unhandledrejection");
  }, true);
})();
</script>{% endif %}
{{ url_state_bootstrap | safe }}
<script>
  (() => {
    const themes = {{ theme_catalog_json | safe }};
    const params = new URLSearchParams(location.search);
    const language = window.ontobdcUrlState?.value("lang") ?? params.get("lang");
    if (language) {
      document.documentElement.lang = language;
      document.documentElement.dataset.language = language;
    }
    const requested = window.ontobdcUrlState?.value("theme") ?? params.get("theme");
    const theme = themes.find((candidate) => candidate.name === requested) ?? themes[0];
    if (!theme) return;
    document.documentElement.dataset.theme = theme.name;
    document.documentElement.style.colorScheme = theme.name === "dark" ? "dark" : "light";
    for (const [key, value] of Object.entries(theme.tokens ?? {})) {
      document.documentElement.style.setProperty(`--onto-theme-${key}`, value);
    }
    document.addEventListener("DOMContentLoaded", () => {
      const backLink = document.querySelector(".back-link");
      if (!backLink) return;
      backLink.href = decorateInternalUrl(backLink.getAttribute("href"));
    });

    function decorateInternalUrl(href) {
      const state = window.ontobdcUrlState;
      if (state && typeof state.decorate === "function") return state.decorate(href);
      const applied = {
        lang: () => document.documentElement.lang || document.documentElement.dataset.language || "",
        theme: () => document.documentElement.dataset.theme || "",
      };
      try {
        const target = new URL(href, location.href);
        const current = new URLSearchParams(location.search);
        for (const name of ["lang", "theme"]) {
          if (target.searchParams.has(name)) continue;
          const carried = current.get(name) || applied[name]();
          if (carried) target.searchParams.set(name, carried);
        }
        return target.href;
      } catch {
        return href;
      }
    }
  })();
</script>
