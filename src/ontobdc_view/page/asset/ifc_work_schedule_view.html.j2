<script>
window.addEventListener("load", function () {
  const rt = window.OntoBDCGanttViewRuntime;
  const dialog = document.getElementById("gantt-filter-dialog");
  const form = document.getElementById("gantt-filter-form");
  const startInput = document.getElementById("gantt-filter-start");
  const endInput = document.getElementById("gantt-filter-end");
  const criticalInput = document.getElementById("gantt-filter-critical");
  const openBtn = document.querySelector(".gantt-filter-btn");
  const closeBtn = document.querySelector(".gantt-filter-close");
  const resetBtn = document.querySelector(".gantt-filter-reset");
  const fsBtn = document.querySelector(".gantt-fullscreen-btn");

  // ── Fullscreen toggle ──────────────────────────────────────────────────
  if (fsBtn) {
    const ENTER_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>';
    const EXIT_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/><path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/></svg>';
    function t(key, fallback) {
      try {
        const rt_ = window.OntoBDCGanttViewRuntime;
        if (rt_ && typeof rt_.t === "function") {
          const value = rt_.t(key);
          if (value && value !== key) return value;
        }
      } catch (e) {}
      return fallback;
    }
    function setFsIcon(active) {
      const label = active ? t("exitFullscreen", "Exit fullscreen") : t("enterFullscreen", "Open fullscreen");
      fsBtn.innerHTML = active ? EXIT_SVG : ENTER_SVG;
      fsBtn.setAttribute("title", label);
      fsBtn.setAttribute("aria-label", label);
      if (active) {
        document.documentElement.classList.add("is-fullscreen-presenting");
        document.documentElement.dataset.fullscreenPresenting = "true";
      } else {
        document.documentElement.classList.remove("is-fullscreen-presenting");
        delete document.documentElement.dataset.fullscreenPresenting;
      }
    }
    function isFsActive() {
      try {
        return Boolean(document.fullscreenElement || document.webkitFullscreenElement);
      } catch (e) { return false; }
    }
    function refreshFsState() {
      setFsIcon(isFsActive());
      try { window.dispatchEvent(new Event("resize")); } catch (e) {}
    }
    fsBtn.addEventListener("click", function () {
      try {
        if (isFsActive()) {
          const exit = document.exitFullscreen || document.webkitExitFullscreen;
          if (exit) exit.call(document);
        } else {
          const root = document.documentElement;
          const req = root.requestFullscreen || root.webkitRequestFullscreen;
          if (req) req.call(root);
        }
      } catch (e) {}
      setTimeout(refreshFsState, 0);
    });
    if ("onfullscreenchange" in document) {
      document.addEventListener("fullscreenchange", refreshFsState);
    } else if ("onwebkitfullscreenchange" in document) {
      document.addEventListener("webkitfullscreenchange", refreshFsState);
    }
    refreshFsState();
  }

  if (!rt || !dialog || !form || !openBtn || typeof rt.runRender !== "function") return;

  const originalRunRender = rt.runRender.bind(rt);
  const originalRunParse = typeof rt.runParse === "function" ? rt.runParse.bind(rt) : null;
  const filter = rt.state.ganttFilter = {
    start: null,
    end: null,
    showCritical: false,
    sourceTasks: Array.isArray(rt.state.enrichedTasks) ? rt.state.enrichedTasks : [],
    renderedTasks: null
  };

  function dayStart(value) {
    if (!value) return null;
    const parts = String(value).split("-").map(Number);
    if (parts.length !== 3 || parts.some(Number.isNaN)) return null;
    return new Date(parts[0], parts[1] - 1, parts[2]);
  }
  function dayEnd(value) {
    const d = dayStart(value);
    if (!d) return null;
    d.setHours(23, 59, 59, 999);
    return d;
  }
  function clippedTask(task) {
    const sourceStart = task.scheduleStart;
    const sourceFinish = task.scheduleFinish || task.scheduleStart;
    if (!sourceStart && !sourceFinish) return task;
    if (filter.start && sourceFinish && sourceFinish < filter.start) return null;
    if (filter.end && sourceStart && sourceStart > filter.end) return null;
    const start = filter.start && sourceStart && sourceStart < filter.start ? new Date(filter.start) : sourceStart;
    const finish = filter.end && sourceFinish && sourceFinish > filter.end ? new Date(filter.end) : sourceFinish;
    const clone = Object.assign({}, task, {
      scheduleStart: start,
      scheduleFinish: finish,
      isCritical: filter.showCritical ? task.isCritical : false
    });
    if (start && finish) clone.duration_days = Math.max(0.25, (finish.getTime() - start.getTime()) / rt.MILLIS_PER_DAY + 1);
    return clone;
  }
  function renderFiltered() {
    const current = Array.isArray(rt.state.enrichedTasks) ? rt.state.enrichedTasks : [];
    if (current !== filter.renderedTasks) filter.sourceTasks = current;
    const visible = filter.sourceTasks.map(clippedTask).filter(Boolean);
    filter.renderedTasks = visible;
    rt.state.enrichedTasks = visible;
    const schedule = rt.state.schedule;
    rt.state.schedule = null;
    originalRunRender();
    rt.state.schedule = schedule;
    if (typeof rt.runArrows === "function") rt.runArrows();
    // The critical-path toggle is disabled for now, so only the date range
    // marks the filter as active.
    openBtn.dataset.filterActive = String(Boolean(filter.start || filter.end));
  }
  if (originalRunParse) {
    rt.runParse = function () {
      originalRunParse();
      filter.sourceTasks = Array.isArray(rt.state.enrichedTasks) ? rt.state.enrichedTasks : [];
      filter.renderedTasks = null;
    };
  }
  rt.runRender = renderFiltered;

  openBtn.addEventListener("click", function () {
    startInput.value = filter.start ? rt.formatDate(filter.start) : "";
    endInput.value = filter.end ? rt.formatDate(filter.end) : "";
    criticalInput.checked = filter.showCritical;
    dialog.showModal();
  });
  closeBtn.addEventListener("click", function () { dialog.close(); });
  dialog.addEventListener("click", function (event) { if (event.target === dialog) dialog.close(); });
  form.addEventListener("submit", function (event) {
    event.preventDefault();
    const start = dayStart(startInput.value);
    const end = dayEnd(endInput.value);
    if (start && end && start > end) {
      startInput.setCustomValidity(rt.t("ganttFilterInvalidRange"));
      startInput.reportValidity();
      return;
    }
    startInput.setCustomValidity("");
    filter.start = start;
    filter.end = end;
    filter.showCritical = criticalInput.checked;
    dialog.close();
    renderFiltered();
  });
  resetBtn.addEventListener("click", function () {
    startInput.value = "";
    endInput.value = "";
    criticalInput.checked = false;
    filter.start = null;
    filter.end = null;
    filter.showCritical = false;
    dialog.close();
    renderFiltered();
  });

  renderFiltered();
});
</script>
</body>
</html>
